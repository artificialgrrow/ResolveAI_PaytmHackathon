# ==============================================================================
# ResolveAI - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your API credentials.
# ==============================================================================

# LLM Provider Selection: "groq" | "sarvam" | "openai" | "azure" | "bedrock" | "gemini"
LLM_PROVIDER=groq

# 1. Groq API (Default for fast MVP testing - free tier available at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Sarvam AI (Paytm Hackathon credits / Indic Languages)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-2b

# 3. OpenAI (Optional fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 4. Database Configuration
# Defaults to local zero-config SQLite (backend/paytm_resolve.db).
# Reviewers do NOT need to install PostgreSQL; it works out of the box!
# If you wish to connect an external PostgreSQL instance, uncomment and set:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/paytm_db
DATABASE_URL=

# 5. Safety Guardrails & Thresholds
# Auto-resolution limit in INR. Any transaction exceeding this requires human approval.
AUTO_RESOLUTION_THRESHOLD=25000.0

# 6. Server Configuration
HOST=0.0.0.0
PORT=8000

