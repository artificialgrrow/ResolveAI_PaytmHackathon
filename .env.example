# ==============================================================================
# Paytm QR Armor - Environment Configuration Template (.env.example)
# Copy this file to .env (or backend/.env) and fill in your API credentials.
# ==============================================================================

# LLM Provider Selection: "sarvam" | "groq" | "openai"
LLM_PROVIDER=sarvam

# 1. Sarvam AI (Paytm Hackathon Indic Voice STT & TTS + Language Models)
# Free trial / API keys available at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3

# 2. Groq API (High-speed inference fallback - console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI (Optional fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 4. Database Configuration
# Defaults to local zero-config SQLite (backend/paytm_resolve.db).
# Works automatically out of the box with zero external dependencies!
DATABASE_URL=

# 5. Server Configuration
HOST=0.0.0.0
PORT=8000
